# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# In AI Studio, this is automatically provided from your user secrets.
# Never expose this key in client-side code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable Gemini model identifier (defaults to gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (public configuration safely consumed by browser SDK)
# Provided automatically by AI Studio via firebase-applet-config.json or environment variables
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

